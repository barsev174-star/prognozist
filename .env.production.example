APP_DOMAIN=example.com

# Project
ENVIRONMENT=production
APP_NAME=Telegram Sports Predictions

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://example.com
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_MINUTES=10080
BOT_INTERNAL_TOKEN=change-me-internal-token

# Database
POSTGRES_DB=predictions
POSTGRES_USER=predictions
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://predictions:change-me-strong-password@postgres:5432/predictions

# Telegram
BOT_TOKEN=change-me
BOT_INTERNAL_URL=http://bot:8080
TELEGRAM_WEBAPP_URL=https://example.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
TELEGRAM_VIP_CHANNEL_ID=
TELEGRAM_DISCUSSION_GROUP_ID=

# VIP
VIP_DEFAULT_DURATION_DAYS=30
VIP_STARS_AMOUNT=100
